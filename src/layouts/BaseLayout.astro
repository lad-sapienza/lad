---
import "../styles/global.css"
import SEO from "@lad-sapienza/scms-core/components/SEO/SEO.astro"
import ThemeToggle from "@lad-sapienza/scms-core/components/ThemeToggle"
import LocaleSwitcher from "@lad-sapienza/scms-core/components/LocaleSwitcher"
import { siteMetadata } from "../user.config.mjs"
import MainNavigation from "../components/MainNavigation.astro"
import { LOCALES, LOCALE_LABELS, type Locale } from "@user/utils/i18n"

interface Props {
  locale: Locale
  title?: string
  description?: string
  image?: string
}

const SITE_METADATA_EN = {
  title: 'LAD @Sapienza',
  titleTemplate: '%s | LAD',
  description: 'LAD: Laboratory of Digital Archaeology at Sapienza University of Rome — a research lab for digital technologies applied to archaeology and the humanities.',
}

const { locale, title, description, image } = Astro.props

const localizedMetadata = locale === 'en' ? { ...siteMetadata, ...SITE_METADATA_EN } : siteMetadata
const resolvedTitle = title ?? localizedMetadata.title
const resolvedDescription = description ?? localizedMetadata.description

const currentPath = Astro.url.pathname

const FOOTER = {
  it: {
    labName: "Laboratorio di Archeologia Digitale alla Sapienza",
    director: "Responsabile scientifico: Julian Bogdani",
    department: "Dipartimento di Storia Antropologia Religioni Arte Spettacolo",
    university: "Sapienza Università di Roma",
    departmentTitle: "Dipartimento SARAS Sapienza Università di Roma",
    privacyTitle: "Nota sulla",
    privacyEmphasis: "privacy",
    privacyBody: "Questo sito non traccia l'attività dei suoi lettori e non raccoglie dati personali sulla navigazione, cronologia, preferenze, indirizzo IP, geolocalizzazione o altre informazioni personali, aggregate o meno. Il LAD ha scelto di non raccogliere statistiche sul proprio utilizzo per difendere il diritto alla riservatezza dei propri utenti.",
    madeWith: "Questo sito è stato realizzato con",
    by: "da LAD @Sapienza",
  },
  en: {
    labName: "Laboratory of Digital Archaeology at Sapienza",
    director: "Scientific director: Julian Bogdani",
    department: "Department of History, Anthropology, Religions, Arts, Performing Arts",
    university: "Sapienza University of Rome",
    departmentTitle: "SARAS Department, Sapienza University of Rome",
    privacyTitle: "A note on",
    privacyEmphasis: "privacy",
    privacyBody: "This site does not track its readers' activity and does not collect personal data on browsing, history, preferences, IP address, geolocation, or other personal information, aggregated or otherwise. LAD has chosen not to collect usage statistics in order to protect its users' right to privacy.",
    madeWith: "This site was built with",
    by: "by LAD @Sapienza",
  },
} as const
const f = FOOTER[locale]
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title={resolvedTitle} description={resolvedDescription} image={image} siteMetadata={localizedMetadata} />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body class="min-vh-100 d-flex flex-column">
    <ThemeToggle client:load />
    <LocaleSwitcher client:load locales={[...LOCALES]} currentLocale={locale} labels={LOCALE_LABELS} />
    <header>
      <div class="container px-4 py-4">
        <!-- Logos: LAD on the left axis (shared with nav + content), Sapienza pinned right -->
        <div class="row align-items-center">
          <div class="col-6">
            <a href={`/${locale}/`} title={localizedMetadata.title}>
              <img
                src="/images/lad-blue.png"
                alt="LAD - Laboratorio di Archeologia Digitale"
                class="img-fluid"
                style="max-width: min(250px, 100%);"
              />
            </a>
          </div>
          <div class="col-6 text-end">
            <a
              href="https://www.uniroma1.it/"
              target="_blank"
              title="Sapienza Università di Roma"
            >
              <img
                src="/images/sapienza.png"
                alt="Sapienza Università di Roma"
                class="img-fluid"
                style="max-width: min(250px, 100%);"
              />
            </a>
          </div>
        </div>
      </div>

      <MainNavigation currentPath={currentPath} locale={locale} />
    </header>

    <main class="flex-grow-1">
      <div class="container main_content px-4 py-5">
        <slot />
      </div>
    </main>

    <footer class="lad-footer border-top text-muted mt-5 bg-body-tertiary">
      <div class="container px-4 py-5">
        <div class="row g-4 text-center text-md-start">
          <!-- LAD Info -->
          <div class="col-12 col-md-4">
            <div
              class="lad-logo mb-3 mx-auto mx-md-0"
              style="height: 2rem; width: 6rem; mask: url('/images/lad.svg') no-repeat center / contain; -webkit-mask: url('/images/lad.svg') no-repeat center / contain; background-color: var(--color-text-muted);"
            >
            </div>
            <h5 class="fw-semibold mb-2">
              {f.labName}
            </h5>
            <p class="small text-muted">
              {f.director}
            </p>
          </div>

          <!-- Department Info -->
          <div class="col-12 col-md-4">
            <h5 class="fw-semibold mb-2">
              <a
                href="https://saras.uniroma1.it/"
                class="text-body-emphasis text-decoration-none"
                title={f.departmentTitle}
              >
                {f.department}<br />
                {f.university}
              </a>
            </h5>
          </div>

          <!-- Privacy Note -->
          <div class="col-12 col-md-4">
            <h5 class="fw-semibold text-body-emphasis mb-2">
              {f.privacyTitle} <em>{f.privacyEmphasis}</em>
            </h5>
            <p class="small text-muted">
              {f.privacyBody}
            </p>
          </div>
        </div>

        <div class="mt-5 pt-4 border-top text-center">
          <p class="small text-muted">
            {f.madeWith}
            <a
              href="https://github.com/lad-sapienza/scms"
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary text-decoration-none"
            >
              s:CMS
            </a>
            {f.by}
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
