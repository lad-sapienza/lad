---
import SectionIndex from "@user/components/SectionIndex.astro"
import { LOCALES, type Locale } from "@user/utils/i18n"

export const prerender = true

export function getStaticPaths() {
  return LOCALES.map(locale => ({ params: { locale } }))
}

const { locale } = Astro.params as { locale: Locale }

const COPY = {
  it: {
    title: "Ricerca",
    description: "Ricerca di LAD: Linee di ricerca, progetti sul campo e in laboratorio, idee collaborazioni e molto altro",
    lead: "Le linee di ricerca del LAD: Laboratorio di Archeologia Digitale alla Sapienza coprono varie tematiche e aree applicative: dalla ricerca sul campo, allo sviluppo, laboratori e vari servizi web. Di seguitio riportiamo i nostri progetti più importanti.",
  },
  en: {
    title: "Research",
    description: "LAD Research: research lines, fieldwork and lab projects, ideas, collaborations, and more",
    lead: "LAD's research lines — Laboratory of Digital Archaeology at Sapienza — span a range of topics and application areas: from fieldwork to development, labs, and various web services. Below are our most important projects.",
  },
} as const
const c = COPY[locale]
---

<SectionIndex
  collection='ricerca'
  title={c.title}
  description={c.description}
  locale={locale}
>
    <div class="lead">
      {c.lead}
    </div>
</SectionIndex>
