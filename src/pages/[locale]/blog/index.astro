---
import SectionIndex from "@user/components/SectionIndex.astro"
import { LOCALES, type Locale } from "@user/utils/i18n"

export const prerender = true

export function getStaticPaths() {
  return LOCALES.map(locale => ({ params: { locale } }))
}

const { locale } = Astro.params as { locale: Locale }

const COPY = {
  it: {
    title: "Il Blog del LAD",
    description: "Il blog è una delle sezioni più dinamiche del LAD: Laboratorio di Archeologia Digitale alla Sapienza in quanto raccoglie contributo di varia lunghezza conteneneti recensioni, notizie, tutorial, appunti e note relative a progetti, tecnologie, strummenti, standard in uso nel campo della ricerca archeologica. Si tratta di uno spazio aperto e collaboratico, per il quale accettiamo e stimoliamo contribuzioni esterne, per le quali vi preghiamo di scrivere a julian.bogdani@uniroma1.it.",
    h1: "Il blog del LAD",
    leadBefore: "Il blog è una delle sezioni più dinamiche del LAD: Laboratorio di Archeologia Digitale alla Sapienza in quanto raccoglie contributo di varia lunghezza conteneneti recensioni, notizie, tutorial, appunti e note relative a progetti, tecnologie, strummenti, standard in uso nel campo della ricerca archeologica. Si tratta di uno spazio aperto e collaboratico, per il quale accettiamo e stimoliamo contribuzioni esterne, per le quali vi preghiamo di scrivere a ",
  },
  en: {
    title: "The LAD Blog",
    description: "The blog is one of the most dynamic sections of LAD: Laboratory of Digital Archaeology at Sapienza, gathering contributions of varying length — reviews, news, tutorials, notes on projects, technologies, tools, and standards used in archaeological research. It's an open, collaborative space: external contributions are welcome and encouraged — write to julian.bogdani@uniroma1.it.",
    h1: "The LAD blog",
    leadBefore: "The blog is one of the most dynamic sections of LAD: Laboratory of Digital Archaeology at Sapienza, gathering contributions of varying length — reviews, news, tutorials, notes on projects, technologies, tools, and standards used in archaeological research. It's an open, collaborative space: external contributions are welcome and encouraged — write to ",
  },
} as const
const c = COPY[locale]
---

<SectionIndex
  collection="blog"
  title={c.title}
  description={c.description}
  locale={locale}
>
  <p class="lead">
    {c.leadBefore}
    <a href="mailto:julian.bogdani@uniroma1.it">julian.bogdani@uniroma1.it</a>.
  </p>
</SectionIndex>
