---
import { RedirectPage } from "@lad-sapienza/scms-core"
import { getCollection } from "astro:content"
import { splitLocaleId, slugFromRest } from "@user/utils/i18n"

export const prerender = true

export async function getStaticPaths() {
  const articles = await getCollection("blog")
  return articles
    .filter(a => splitLocaleId(a.id).locale === "it")
    .map(a => ({ params: { slug: slugFromRest(splitLocaleId(a.id).rest) } }))
}

const { slug } = Astro.params
---
<RedirectPage target={`/it/blog/${slug}/`} />
