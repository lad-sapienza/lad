---
import BaseLayout from "../layouts/BaseLayout.astro"
import { getCollection } from "astro:content"
import { splitLocaleId, slugFromRest, type Locale } from "@user/utils/i18n"

export interface Props {
  title: string
  description: string
  collection: string
  locale: Locale
  /** Render the page <h1> from `title`. Set false when the slot supplies its own heading. */
  heading?: boolean
}

const { title, description, collection, locale, heading = true } = Astro.props

const allowedCollections = ["blog", "didattica", "notizie", "ricerca", "sviluppo"] as const;
type AllowedCollection = typeof allowedCollections[number];
if (!allowedCollections.includes(collection as AllowedCollection)) {
  throw new Error(`Invalid collection: ${collection}`);
}
const allArticles = await getCollection(collection as AllowedCollection)
const articles = allArticles.filter(a => splitLocaleId(a.id).locale === locale)
const sortedArticles = articles.sort((a, b) => {
  if (a.data.pinned && !b.data.pinned) return -1
  if (!a.data.pinned && b.data.pinned) return 1
  const dateA: number = a.data.date ? new Date(a.data.date).getTime() : 0
  const dateB: number = b.data.date ? new Date(b.data.date).getTime() : 0
  return dateB - dateA
})

const STRINGS = {
  it: { publishedOn: "Pubblicata il", readMore: "Leggi tutto →", pinned: "In evidenza" },
  en: { publishedOn: "Published on", readMore: "Read more →", pinned: "Featured" },
} as const
const t = STRINGS[locale]
const dateLocale = locale === "en" ? "en-GB" : "it-IT"
---

<BaseLayout locale={locale} title={title} description={description}>
  <div class="lad-prose lad-prose--wide">
    {heading && <h1 class="lad-title">{title}</h1>}
    <slot />
  </div>

  {sortedArticles && sortedArticles.length > 0 && (
    <div class="lad-index lad-prose--wide">
      {sortedArticles.map(article => {
        const slug = slugFromRest(splitLocaleId(article.id).rest)
        const href = `/${locale}/${article.collection}/${slug}/`
        const imgHref = `/${article.collection}/it/${slug}/${article.data.img}`
        const dateStr = article.data.date
          ? new Date(article.data.date).toLocaleDateString(dateLocale, { year: "numeric", month: "long", day: "numeric" })
          : ""
        return (
          <article class:list={["lad-index__item", article.data.pinned && "lad-index__item--pinned"]}>
            <div>
              <p class="lad-index__meta">
                {article.data.pinned ? t.pinned : dateStr ? `${t.publishedOn} ${dateStr}` : ""}
              </p>
              <h2 class="lad-index__title">
                <a href={href}>{article.data.title}</a>
              </h2>
              <p class="lad-index__desc">{article.data.description}</p>
              <p class="mt-2 mb-0"><a href={href}>{t.readMore}</a></p>
            </div>
            {article.data.img && (
              <a href={href} aria-hidden="true" tabindex="-1">
                <img src={imgHref} alt="" class="lad-index__thumb" loading="lazy" />
              </a>
            )}
          </article>
        )
      })}
    </div>
  )}
</BaseLayout>
