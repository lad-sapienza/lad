---
import { Home, Users, Newspaper, Edit, LibraryBig, Code, GraduationCap, Menu, X } from "lucide-react"
import type { Locale } from "@user/utils/i18n"

interface Props {
  currentPath: string
  locale: Locale
}

const { currentPath, locale } = Astro.props

const LABELS = {
  it: { home: "Inizio", chiSiamo: "Chi siamo", notizie: "Notizie", blog: "Blog", ricerca: "Ricerca", sviluppo: "Sviluppo", didattica: "Didattica" },
  en: { home: "Home", chiSiamo: "About us", notizie: "News", blog: "Blog", ricerca: "Research", sviluppo: "Development", didattica: "Teaching" },
} as const
const t = LABELS[locale]

const p = (path: string) => `/${locale}${path}`

// Navigation items configuration
const menuItems = [
  {
    href: p("/"),
    label: t.home,
    isActive: currentPath === p("/"),
    icon: "home"
  },
  {
    href: p("/chi-siamo/"),
    label: t.chiSiamo,
    isActive: currentPath === p("/chi-siamo/"),
    icon: "users"
  },
  {
    href: p("/notizie/"),
    label: t.notizie,
    isActive: currentPath.startsWith(p("/notizie/")),
    icon: "newspaper"
  },
  {
    href: p("/blog/"),
    label: t.blog,
    isActive: currentPath.startsWith(p("/blog/")),
    icon: "edit"
  },
  {
    href: p("/ricerca/"),
    label: t.ricerca,
    isActive: currentPath.startsWith(p("/ricerca/")),
    icon: "library-big"
  },
  {
    href: p("/sviluppo/"),
    label: t.sviluppo,
    isActive: currentPath.startsWith(p("/sviluppo/")),
    icon: "code"
  },
  {
    href: p("/didattica/"),
    label: t.didattica,
    isActive: currentPath.startsWith(p("/didattica/")),
    icon: "graduation-cap"
  },
]
---

<nav class="navbar bg-body-tertiary navbar-expand-md border-top border-bottom">
  <div class="container-sm px-4">
    <button
      id="navbar-toggler"
      class="navbar-toggler border-0 p-2"
      type="button"
      aria-controls="navbarNav"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="toggler-icon-open"><Menu size={24} /></span>
      <span class="toggler-icon-close" style="display:none"><X size={24} /></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav mb-md-0 me-md-auto">
        {
          menuItems.map(item => (
            <li class="nav-item fw-bold mx-auto mx-md-0 pe-md-4 py-1">
              <a
                class:list={["nav-link d-flex flex-row flex-md-column align-items-center", item.isActive ? "active" : ""]}
                href={item.href}
              >
                {item.icon === "home" && <Home size={20} />}
                {item.icon === "users" && <Users size={20} />}
                {item.icon === "newspaper" && <Newspaper size={20} />}
                {item.icon === "edit" && <Edit size={20} />}
                {item.icon === "library-big" && <LibraryBig size={20} />}
                {item.icon === "code" && <Code size={20} />}
                {item.icon === "graduation-cap" && <GraduationCap size={20} />}
                <span class={item.icon ? "ms-2 mt-md-1 ms-md-0" : ""}>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>

<script>
  const toggler = document.getElementById('navbar-toggler');
  const target = document.getElementById('navbarNav');

  if (toggler && target) {
    toggler.addEventListener('click', () => {
      const isOpen = target.classList.toggle('show');
      toggler.setAttribute('aria-expanded', String(isOpen));
      const openIcon = toggler.querySelector('.toggler-icon-open') as HTMLElement;
      const closeIcon = toggler.querySelector('.toggler-icon-close') as HTMLElement;
      if (openIcon) openIcon.style.display = isOpen ? 'none' : '';
      if (closeIcon) closeIcon.style.display = isOpen ? '' : 'none';
    });
  }
</script>
