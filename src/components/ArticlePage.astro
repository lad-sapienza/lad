---
import BaseLayout from "../layouts/BaseLayout.astro"
import { getCollection, render } from "astro:content"
import Gallery from "@lad-sapienza/scms-core/components/Gallery/Gallery.astro"
import ShareButtons from "./ShareButtons.jsx"
import { splitLocaleId, slugFromRest, type Locale } from "@user/utils/i18n"

interface Props {
  collection: string
  slug: string
  locale: Locale
}

const { collection, slug, locale } = Astro.props as Props
const allowedCollections = [
  "blog",
  "didattica",
  "notizie",
  "ricerca",
  "sviluppo",
] as const
type AllowedCollection = (typeof allowedCollections)[number]
if (!allowedCollections.includes(collection as AllowedCollection)) {
  throw new Error(`Invalid collection: ${collection}`)
}
const articles = await getCollection(collection as AllowedCollection)
const entry = articles.find((a) => {
  const { locale: entryLocale, rest } = splitLocaleId(a.id)
  return entryLocale === locale && slugFromRest(rest) === slug
})
if (!entry) throw new Error(`Entry not found for ${collection}/${locale}/${slug}`)
const { Content } = await render(entry)
// Images always live alongside the canonical Italian article — see plan: no per-locale asset duplication.
const entryImage = entry.data.img
  ? `/${collection}/it/${slug}/${entry.data.img}`
  : undefined

const SECTION_LABELS: Record<AllowedCollection, { it: string; en: string }> = {
  blog: { it: "Blog", en: "Blog" },
  didattica: { it: "Didattica", en: "Teaching" },
  notizie: { it: "Notizie", en: "News" },
  ricerca: { it: "Ricerca", en: "Research" },
  sviluppo: { it: "Sviluppo", en: "Development" },
}
const STRINGS = {
  it: { back: "← Torna indietro alla pagina principale", tag: "Tag", publishedOn: "Pubblicato il" },
  en: { back: "← Back to the main", tag: "Tags", publishedOn: "Published on" },
} as const
const t = STRINGS[locale]
const sectionLabel = SECTION_LABELS[collection as AllowedCollection][locale]
const backHref = `/${locale}/${collection}/`
const backLabel = locale === "en" ? `${t.back} ${sectionLabel} page` : `${t.back} ${sectionLabel}`
const dateLocale = locale === "en" ? "en-GB" : "it-IT"
const publishedDate = entry.data.date
  ? new Date(entry.data.date).toLocaleDateString(dateLocale, { year: "numeric", month: "long", day: "numeric" })
  : ""
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  image={entryImage}
>
  <article class="lad-article" data-locale={locale}>
    <p class="lad-kicker">
      <a href={backHref} title={backLabel}>← {sectionLabel}</a>
    </p>
    <h1 class="lad-title">{entry.data.title}</h1>

    <div class="lad-article__meta">
      <span class="lad-article__date">{publishedDate}</span>
      <span class="lad-article__share d-print-none">
        <ShareButtons
          client:load
          variant="inline"
          url={Astro.url.href}
          title={entry.data.title}
          tags={entry.data.tags}
          locale={locale}
        />
      </span>
      {
        entry.data.tags && entry.data.tags.length > 0 && (
          <span class="lad-article__tags d-print-none">{t.tag}: {entry.data.tags.join(", ")}</span>
        )
      }
    </div>

    {
      entry.data.img && (
        <figure class="lad-article__figure">
          <img src={entryImage} alt={entry.data.title} class="img-fluid" />
        </figure>
      )
    }

    <div class="lad-article__body">
      <Content />
      <Gallery />
    </div>
  </article>
</BaseLayout>

<script>
  // Every image in the article (hero + inline) opens in a shared PhotoSwipe
  // gallery — click one, page through the rest. The colocated <Gallery> grid
  // keeps its own lightbox, so it is excluded here.
  import PhotoSwipeLightbox from "photoswipe/lightbox"
  import "photoswipe/style.css"

  const ZOOM_LABEL = { it: "Ingrandisci l'immagine", en: "Enlarge image" }

  const article = document.querySelector(".lad-article")
  if (article instanceof HTMLElement && !article.dataset.lightboxReady) {
    article.dataset.lightboxReady = "1"
    const locale = article.dataset.locale === "en" ? "en" : "it"
    const zoomLabel = ZOOM_LABEL[locale]

    const images = Array.from(article.querySelectorAll("img")).filter(
      (img) => !img.closest(".gallery-grid") && !img.closest(".pswp"),
    )

    if (images.length > 0) {
      const dims = (img: HTMLImageElement) => ({
        width: parseInt(img.getAttribute("width") || "", 10) || img.naturalWidth || 1600,
        height: parseInt(img.getAttribute("height") || "", 10) || img.naturalHeight || 1200,
      })

      const lightbox = new PhotoSwipeLightbox({
        pswpModule: () => import("photoswipe"),
        // fade, not zoom: the gallery is built on the fly without bound
        // thumbnail elements, so there is no rect to zoom back to.
        showHideAnimationType: "fade",
        bgOpacity: 0.92,
        loop: false,
      })

      // Skip captions that add nothing: a bare filename, or the article title
      // repeated (the hero image alt is the title).
      const pageTitle = (document.querySelector(".lad-title")?.textContent || "").trim()
      const isFilename = (s: string) =>
        /^[\w .,()+-]+\.(jpe?g|png|gif|webp|avif|svg)$/i.test(s)
      const caption = (img: HTMLImageElement) => {
        const alt = (img.alt || "").trim()
        return !alt || isFilename(alt) || alt === pageTitle ? "" : alt
      }

      lightbox.on("uiRegister", () => {
        lightbox.pswp?.ui?.registerElement({
          name: "caption",
          order: 9,
          isButton: false,
          appendTo: "root",
          onInit: (el, pswp) => {
            el.className = "pswp__custom-caption"
            pswp.on("change", () => {
              const text = (pswp.currSlide?.data as { alt?: string })?.alt || ""
              el.textContent = text
              el.style.display = text ? "block" : "none"
            })
          },
        })
      })

      lightbox.init()

      const open = (index: number) => {
        lightbox.loadAndOpen(
          index,
          images.map((img) => {
            const src = img.currentSrc || img.src
            return { src, msrc: src, alt: caption(img), ...dims(img) }
          }),
        )
      }

      images.forEach((img, i) => {
        img.style.cursor = "zoom-in"
        img.setAttribute("role", "button")
        img.setAttribute("tabindex", "0")
        if (!img.hasAttribute("aria-label")) {
          img.setAttribute("aria-label", img.alt ? `${zoomLabel}: ${img.alt}` : zoomLabel)
        }
        const fire = (e: Event) => {
          e.preventDefault()
          open(i)
        }
        img.addEventListener("click", fire)
        img.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") fire(e)
        })
        img.closest("a")?.addEventListener("click", (e) => e.preventDefault())
      })
    }
  }
</script>
