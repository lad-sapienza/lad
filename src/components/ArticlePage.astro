---
import BaseLayout from "../layouts/BaseLayout.astro"
import { getCollection, render } from "astro:content"
import Gallery from "@lad-sapienza/scms-core/components/Gallery/Gallery.astro"
import ShareButtons from "./ShareButtons.jsx"
import { splitLocaleId, slugFromRest, type Locale } from "@user/utils/i18n"

interface Props {
  collection: string
  slug: string
  locale: Locale
}

const { collection, slug, locale } = Astro.props as Props
const allowedCollections = [
  "blog",
  "didattica",
  "notizie",
  "ricerca",
  "sviluppo",
] as const
type AllowedCollection = (typeof allowedCollections)[number]
if (!allowedCollections.includes(collection as AllowedCollection)) {
  throw new Error(`Invalid collection: ${collection}`)
}
const articles = await getCollection(collection as AllowedCollection)
const entry = articles.find((a) => {
  const { locale: entryLocale, rest } = splitLocaleId(a.id)
  return entryLocale === locale && slugFromRest(rest) === slug
})
if (!entry) throw new Error(`Entry not found for ${collection}/${locale}/${slug}`)
const { Content } = await render(entry)
// Images always live alongside the canonical Italian article — see plan: no per-locale asset duplication.
const entryImage = entry.data.img
  ? `/${collection}/it/${slug}/${entry.data.img}`
  : undefined

const SECTION_LABELS: Record<AllowedCollection, { it: string; en: string }> = {
  blog: { it: "Blog", en: "Blog" },
  didattica: { it: "Didattica", en: "Teaching" },
  notizie: { it: "Notizie", en: "News" },
  ricerca: { it: "Ricerca", en: "Research" },
  sviluppo: { it: "Sviluppo", en: "Development" },
}
const STRINGS = {
  it: { back: "← Torna indietro alla pagina principale", tag: "Tag", publishedOn: "Pubblicato il" },
  en: { back: "← Back to the main", tag: "Tags", publishedOn: "Published on" },
} as const
const t = STRINGS[locale]
const sectionLabel = SECTION_LABELS[collection as AllowedCollection][locale]
const backHref = `/${locale}/${collection}/`
const backLabel = locale === "en" ? `${t.back} ${sectionLabel} page` : `${t.back} ${sectionLabel}`
const dateLocale = locale === "en" ? "en-GB" : "it-IT"
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  image={entryImage}
>
  <main>
    <a href={backHref} title={backLabel}>
      {backLabel}
    </a>

    <article>
      <h1 class="my-5 text-center">{entry.data.title}</h1>

      {
        entry.data.tags && (
          <div class="text-center font-monospace">
            <div class="bg-light mb-3 pt-3 px-3 text-muted d-inline-block d-print-none">
              <p>{t.tag}: {entry.data.tags?.join(", ")}</p>
            </div>
          </div>
        )
      }

      <p class="text-center text-muted">
        {t.publishedOn} {
          entry.data.date
            ? new Date(entry.data.date).toLocaleDateString(dateLocale, {
                year: "numeric",
                month: "long",
                day: "numeric",
              })
            : ""
        }
      </p>

      <ShareButtons
          client:load
          url={Astro.url.href}
          title={entry.data.title}
          tags={entry.data.tags}
          locale={locale}
        />

      {
        entry.data.img && (
          <div class="my-5 py-5 text-center">
            <img
              src={entryImage}
              alt={entry.data.title}
              class="shadow img-fluid"
            />
          </div>
        )
      }

      <!-- Content -->
      <div>
        <Content />
        <Gallery />
      </div>
    </article>
  </main>
</BaseLayout>
